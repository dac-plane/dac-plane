{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolCatalogue",
  "description": "A connector's reply to list_tools: the tools it offers, each a governed action class connector.<name>. Tool names are distinct.",
  "type": "object",
  "required": [
    "tools"
  ],
  "additionalProperties": false,
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "required": [
        "name",
        "description",
        "input_schema"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "../lifecycle/common.schema.json#/$defs/toolName"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "input_schema": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            }
          }
        },
        "read_only": {
          "type": "boolean"
        }
      }
    }
  }
}
