{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_ref",
    "turn_ref",
    "source_revision",
    "artifacts"
  ],
  "properties": {
    "session_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "turn_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "native_ref",
          "kind",
          "digest",
          "size",
          "media_type"
        ],
        "properties": {
          "native_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "enum": [
              "code_change",
              "test_result",
              "visual_proof",
              "external_action",
              "agent_claim"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "media_type": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
          }
        }
      }
    }
  }
}
