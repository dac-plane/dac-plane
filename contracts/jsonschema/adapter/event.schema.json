{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "description": "An unsolicited provider observation with the binding the provider claims. The claim is untrusted until checked against the authenticated peer and a recorded provider operation.",
  "type": "object",
  "required": ["tenant_id", "attempt_id", "provider_id", "operation_id", "stream", "generation", "body"],
  "additionalProperties": false,
  "properties": {
    "tenant_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "attempt_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "provider_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "operation_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "stream": { "$ref": "common.schema.json#/$defs/name" },
    "generation": { "$ref": "../identity/common.schema.json#/$defs/generation" },
    "body": { "$ref": "stream-frame.schema.json" }
  }
}
