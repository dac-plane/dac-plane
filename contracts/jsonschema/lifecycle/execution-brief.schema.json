{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExecutionBrief",
  "description": "The product-owned requested outcome a runtime executes.",
  "type": "object",
  "required": ["objective", "acceptance_criteria"],
  "additionalProperties": false,
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "\\S"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000,
        "pattern": "\\S"
      }
    }
  }
}
