{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision",
  "description": "An immutable answer to one version of one attention request. Answer content is referenced by digest and stored outside this record.",
  "type": "object",
  "required": ["decision_id", "tenant_id", "attention_id", "request_version", "principal_id", "kind", "decided_at"],
  "additionalProperties": false,
  "properties": {
    "decision_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "tenant_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "attention_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "request_version": { "$ref": "../identity/common.schema.json#/$defs/generation" },
    "principal_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "kind": { "enum": ["approve_once", "approve_standing", "deny", "answer"] },
    "answer_digest": { "$ref": "../identity/common.schema.json#/$defs/digest" },
    "decided_at": { "$ref": "../identity/common.schema.json#/$defs/timestamp" }
  },
  "if": { "properties": { "kind": { "const": "answer" } } },
  "then": { "required": ["answer_digest"] },
  "else": { "not": { "required": ["answer_digest"] } }
}
