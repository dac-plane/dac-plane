{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResultRevision",
  "description": "One immutable proposed result of a Task, made of committed artifacts. Rework creates a new revision naming its predecessor; only the first revision has none.",
  "type": "object",
  "required": ["revision_id", "tenant_id", "task_id", "attempt_id", "number", "artifact_ids", "created_at"],
  "additionalProperties": false,
  "properties": {
    "revision_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "tenant_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "task_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "attempt_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "number": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "previous_revision_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "artifact_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" }
    },
    "created_at": { "$ref": "../identity/common.schema.json#/$defs/timestamp" }
  },
  "if": { "properties": { "number": { "const": 1 } } },
  "then": { "not": { "required": ["previous_revision_id"] } },
  "else": { "required": ["previous_revision_id"] }
}
