{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MigrationItem",
  "description": "One source Attempt captured by a tenant-wide harness migration. A target attempt means restart-from-artifacts, never native-session resume.",
  "type": "object",
  "required": ["tenant_id", "migration_id", "source_attempt_id", "state", "claim_epoch", "updated_at"],
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "state": { "const": "unresolved" } }, "required": ["state"] }, "then": { "required": ["reason"] }, "else": { "not": { "required": ["reason"] } } }
  ],
  "properties": {
    "tenant_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "migration_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "source_attempt_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "target_attempt_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "quiesce_operation_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "environment_operation_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "restart_operation_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "cleanup_operation_id": { "$ref": "../identity/common.schema.json#/$defs/uuidv7" },
    "context_refs": { "type": "array", "maxItems": 32, "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" } },
    "environment_ref": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,255}$" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 128 },
    "state": { "enum": ["queued", "quiescing", "starting", "cutover", "cleaning_up", "completed", "failed", "unresolved"] },
    "claim_epoch": { "$ref": "../identity/common.schema.json#/$defs/generation" },
    "quiesce_epoch": { "$ref": "../identity/common.schema.json#/$defs/generation" },
    "environment_epoch": { "$ref": "../identity/common.schema.json#/$defs/generation" },
    "restart_epoch": { "$ref": "../identity/common.schema.json#/$defs/generation" },
    "cleanup_epoch": { "$ref": "../identity/common.schema.json#/$defs/generation" },
    "updated_at": { "$ref": "../identity/common.schema.json#/$defs/timestamp" }
  }
}
