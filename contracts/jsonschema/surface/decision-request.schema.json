{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionRequest",
  "description": "Body of POST .../attention/{attention}/decisions. An answer decision carries answer_digest, and answer, the text it is the digest of (ADR-0026); the control plane refuses an answer whose digest differs.",
  "type": "object",
  "required": [
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "enum": [
        "approve_once",
        "approve_standing",
        "deny",
        "answer"
      ]
    },
    "answer_digest": {
      "$ref": "../identity/common.schema.json#/$defs/digest"
    },
    "answer": {
      "$ref": "../lifecycle/answer.schema.json"
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "answer"
      }
    }
  },
  "then": {
    "required": [
      "answer_digest"
    ]
  },
  "else": {
    "not": {
      "anyOf": [
        { "required": ["answer_digest"] },
        { "required": ["answer"] }
      ]
    }
  }
}
