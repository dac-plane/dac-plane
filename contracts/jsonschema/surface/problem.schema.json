{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem",
  "description": "An RFC 9457 problem document. detail never echoes request content.",
  "type": "object",
  "required": [
    "type",
    "title",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string",
      "minLength": 1
    }
  }
}
