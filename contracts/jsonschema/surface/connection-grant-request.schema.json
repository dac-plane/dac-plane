{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConnectionGrantRequest",
  "description": "Body of POST /v1/tenants/{tenant}/connections/{connection}/grants. Names exactly one of an agent and a task; the tools must be ones the connector offers.",
  "type": "object",
  "required": [
    "tools",
    "permission",
    "call_limit",
    "expires_at"
  ],
  "additionalProperties": false,
  "properties": {
    "agent_id": {
      "$ref": "../identity/common.schema.json#/$defs/uuidv7"
    },
    "task_id": {
      "$ref": "../identity/common.schema.json#/$defs/uuidv7"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "../lifecycle/common.schema.json#/$defs/toolName"
      }
    },
    "permission": {
      "enum": [
        "ask",
        "always"
      ]
    },
    "call_limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "expires_at": {
      "$ref": "../identity/common.schema.json#/$defs/timestamp"
    }
  },
  "oneOf": [
    {
      "required": [
        "agent_id"
      ],
      "not": {
        "required": [
          "task_id"
        ]
      }
    },
    {
      "required": [
        "task_id"
      ],
      "not": {
        "required": [
          "agent_id"
        ]
      }
    }
  ]
}
