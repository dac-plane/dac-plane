{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "description": "One committed lifecycle event. record_version is the record's own gapless revision.",
  "type": "object",
  "required": [
    "cursor",
    "record_kind",
    "record_id",
    "record_version",
    "event",
    "from_state",
    "occurred_at"
  ],
  "additionalProperties": false,
  "properties": {
    "cursor": {
      "$ref": "#/$defs/cursor"
    },
    "task_id": {
      "$ref": "../identity/common.schema.json#/$defs/uuidv7"
    },
    "record_kind": {
      "enum": [
        "task",
        "attempt",
        "attention_request",
        "provider_operation",
        "harness_qualification",
        "migration_pass",
        "maintenance_claim",
        "budget",
        "reservation",
        "spend_challenge",
        "artifact",
        "authority_use",
        "authority_grant"
      ]
    },
    "record_id": {
      "$ref": "../identity/common.schema.json#/$defs/uuidv7"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "from_state": {
      "type": "string",
      "minLength": 1
    },
    "to_state": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "$ref": "../identity/common.schema.json#/$defs/timestamp"
    }
  },
  "$defs": {
    "cursor": {
      "description": "Opaque, resumable position in one stream: a cursor from another stream or tenant is reset.",
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}\\.(0|[1-9][0-9]{0,18})\\.[0-9a-f]{12}$"
    }
  }
}
