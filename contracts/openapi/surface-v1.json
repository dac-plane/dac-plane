    "/v1/tenants/{tenant}/events": {
      "get": {
        "operationId": "tenantEvents",
        "summary": "Read or stream the tenant's events",
        "parameters": [
          {
            "$ref": "#/components/parameters/Tenant"
          },
          {
            "$ref": "#/components/parameters/After"
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/LastEventID"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of events (application/json) or a Server-Sent Events stream (text/event-stream) whose ids are cursors; a reset event carries next_cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/surface/event-page.schema.json"
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem401"
          },
          "403": {
            "$ref": "#/components/responses/Problem403"
          },
          "422": {
            "$ref": "#/components/responses/Problem422"
          },
          "500": {
            "$ref": "#/components/responses/Problem500"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "An OAuth 2.0 access token (typ at+jwt) from an operator-configured OpenID Connect issuer, bound to a principal of the tenant in the path."
      }
    },
    "parameters": {
      "Tenant": {
        "name": "tenant",
        "in": "path",
        "required": true,
        "description": "The tenant; the bearer identity must be bound to a principal of it.",
        "schema": {
          "$ref": "../jsonschema/identity/common.schema.json#/$defs/uuidv7"
        }
      },
      "Task": {
        "name": "task",
        "in": "path",
        "required": true,
        "description": "The task.",
        "schema": {
          "$ref": "../jsonschema/identity/common.schema.json#/$defs/uuidv7"
        }
      },
      "Attempt": {
        "name": "attempt",
        "in": "path",
        "required": true,
        "description": "The attempt.",
        "schema": {
          "$ref": "../jsonschema/identity/common.schema.json#/$defs/uuidv7"
        }
      },
      "Revision": {
        "name": "revision",
        "in": "path",
        "required": true,
        "description": "The result revision.",
        "schema": {
          "$ref": "../jsonschema/identity/common.schema.json#/$defs/uuidv7"
        }
      },
      "Attention": {
        "name": "attention",
        "in": "path",
        "required": true,
        "description": "The attention request.",
        "schema": {
          "$ref": "../jsonschema/identity/common.schema.json#/$defs/uuidv7"
        }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Client-chosen key, 1 to 128 bytes; the command nonce.",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "description": "The strong ETag of the record version the command was decided on.",
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]*\"$"
        }
      },
      "After": {
        "name": "after",
        "in": "query",
        "required": false,
        "description": "Resume after this cursor; Last-Event-ID takes precedence.",
        "schema": {
          "$ref": "../jsonschema/surface/event.schema.json#/$defs/cursor"
        }
      },
      "LastEventID": {
        "name": "Last-Event-ID",
        "in": "header",
        "required": false,
        "description": "SSE resume cursor. A malformed or foreign cursor is answered with a reset.",
        "schema": {
          "type": "string"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "required": false,
        "description": "Page size, 1 to 500; default 100.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      }
    },
    "headers": {
      "ETag": {
        "description": "Strong entity tag carrying the record version.",
        "schema": {
          "type": "string",
          "pattern": "^\"[1-9][0-9]*\"$"
        }
      }
    },
    "responses": {
      "Problem400": {
        "description": "Malformed request",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "../jsonschema/surface/problem.schema.json"
            }
          }
        }
      },
      "Problem401": {
        "description": "Unauthenticated",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "../jsonschema/surface/problem.schema.json"
            }
          }
        }
      },
      "Problem403": {
        "description": "Forbidden",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "../jsonschema/surface/problem.schema.json"
            }
          }
        }
      },
      "Problem404": {
        "description": "Not found, or not visible to the principal",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "../jsonschema/surface/problem.schema.json"
            }
          }
        }
      },
      "Problem409": {
        "description": "Refused by the lifecycle",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "../jsonschema/surface/problem.schema.json"
            }
          }
        }
      },
      "Problem412": {
        "description": "Stale If-Match version",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "../jsonschema/surface/problem.schema.json"
            }
          }
        }
      },
      "Problem422": {
        "description": "Invalid command, or Idempotency-Key reused with a different body",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "../jsonschema/surface/problem.schema.json"
            }
          }
        }
      },
      "Problem428": {
        "description": "If-Match required",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "../jsonschema/surface/problem.schema.json"
            }
          }
        }
      },
      "Problem500": {
        "description": "Internal error",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "../jsonschema/surface/problem.schema.json"
            }
          }
        }
      }
    }
  }
}
