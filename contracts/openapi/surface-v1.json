{
  "openapi": "3.1.0",
  "info": {
    "title": "dac-plane Surface API",
    "version": "1.0.0",
    "description": "Surface API v1 (ADR-0007). Commands map one-to-one onto application commands; mutating requests require Idempotency-Key, and commands that change an existing record require If-Match with its ETag. Errors are RFC 9457 problems."
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "paths": {
    "/v1/tenants/{tenant}/tasks": {
      "post": {
        "operationId": "submitTask",
        "summary": "Submit a task",
        "parameters": [
          {
            "$ref": "#/components/parameters/Tenant"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "201": {
            "description": "The submission. Replaying the same Idempotency-Key and body returns it again.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/surface/submission.schema.json"
                }
              }
            },
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              },
              "Location": {
                "description": "URL of the created task.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem400"
          },
          "401": {
            "$ref": "#/components/responses/Problem401"
          },
          "403": {
            "$ref": "#/components/responses/Problem403"
          },
          "404": {
            "$ref": "#/components/responses/Problem404"
          },
          "409": {
            "$ref": "#/components/responses/Problem409"
          },
          "422": {
            "$ref": "#/components/responses/Problem422"
          },
          "500": {
            "$ref": "#/components/responses/Problem500"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../jsonschema/surface/submit-task-request.schema.json"
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{tenant}/tasks/{task}": {
      "get": {
        "operationId": "getTask",
        "summary": "Read a task",
