                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem401"
          },
          "403": {
            "$ref": "#/components/responses/Problem403"
          },
          "500": {
            "$ref": "#/components/responses/Problem500"
          }
        }
      }
    },
    "/v1/tenants/{tenant}/attention/{attention}": {
      "get": {
        "operationId": "getAttention",
        "summary": "Read an attention request",
        "parameters": [
