            "$ref": "#/components/parameters/Tenant"
          },
          {
            "$ref": "#/components/parameters/Attention"
          }
        ],
        "responses": {
          "200": {
            "description": "The request.",
            "headers": {
              "ETag": {
                "$ref": "#/components/headers/ETag"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/lifecycle/attention-request.schema.json"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Problem401"
          },
          "403": {
            "$ref": "#/components/responses/Problem403"
          },
          "404": {
            "$ref": "#/components/responses/Problem404"
          },
          "500": {
            "$ref": "#/components/responses/Problem500"
          }
        }
      }
    },
    "/v1/tenants/{tenant}/attention/{attention}/decisions": {
      "post": {
        "operationId": "decide",
        "summary": "Decide an attention request",
        "parameters": [
          {
            "$ref": "#/components/parameters/Tenant"
          },
          {
            "$ref": "#/components/parameters/Attention"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          },
          {
            "$ref": "#/components/parameters/IfMatch"
          }
        ],
        "responses": {
          "201": {
            "description": "The recorded decision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../jsonschema/surface/decision-result.schema.json"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem400"
          },
          "401": {
            "$ref": "#/components/responses/Problem401"
          },
          "403": {
            "$ref": "#/components/responses/Problem403"
          },
          "404": {
            "$ref": "#/components/responses/Problem404"
          },
          "409": {
            "$ref": "#/components/responses/Problem409"
          },
          "412": {
            "$ref": "#/components/responses/Problem412"
          },
          "422": {
            "$ref": "#/components/responses/Problem422"
          },
          "428": {
            "$ref": "#/components/responses/Problem428"
          },
          "500": {
            "$ref": "#/components/responses/Problem500"
          }
        },
        "description": "If-Match carries the attention request version.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "../jsonschema/surface/decision-request.schema.json"
              }
            }
          }
        }
