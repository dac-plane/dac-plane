        <mxCell id="serve" value="&lt;b&gt;dac-plane serve&lt;/b&gt; &#xD7; N replicas&lt;br&gt;&lt;br&gt;Surface API (TLS)&lt;br&gt;Adapter endpoint (TLS WebSocket)&lt;br&gt;Worker: fenced dispatch and reconciliation&lt;br&gt;Operations listener (loopback by default)&lt;br&gt;&lt;br&gt;&lt;i&gt;Refuses to start outside its schema range&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="340" width="400" height="230" as="geometry"/></mxCell>
