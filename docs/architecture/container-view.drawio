        <mxCell id="subtitle" value="One lifecycle owner; every provider reached through an out-of-process adapter" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="50" y="70" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="clients" value="&lt;b&gt;Work surfaces&lt;/b&gt;&lt;br&gt;API clients first&lt;br&gt;Web workspace later" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="20" y="285" width="170" height="110" as="geometry"/></mxCell>
        <mxCell id="system-boundary" value="dac-plane system boundary" style="swimlane;horizontal=1;startSize=38;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#666666;fontColor=#111111;fontSize=16;fontStyle=1;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="640" height="780" as="geometry"/></mxCell>
        <mxCell id="application" value="&lt;b&gt;Control-plane application&lt;/b&gt;&lt;br&gt;&lt;br&gt;Surface API and actor authorization&lt;br&gt;Task &#xB7; Attempt &#xB7; Attention &#xB7; Decision lifecycle&lt;br&gt;Budgets &#xB7; Artifacts &#xB7; Results &#xB7; Review&lt;br&gt;Transactional outbox dispatch and reconciliation&lt;br&gt;Adapter endpoint: authenticated ControlFrame&lt;br&gt;Bound normalized-event ingestion&lt;br&gt;&lt;br&gt;&lt;i&gt;LIFECYCLE CORE PROVEN IN M1 WITH SIMULATORS&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=2;fontColor=#111111;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="380" y="210" width="500" height="350" as="geometry"/></mxCell>
        <mxCell id="postgres" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;Authoritative product records&lt;br&gt;Audit &#xB7; leases &#xB7; transactional outbox&lt;br&gt;Artifact identity, digest and lineage" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="700" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="adapters" value="&lt;b&gt;Provider adapters&lt;/b&gt;&lt;br&gt;&lt;br&gt;One process per provider,&lt;br&gt;built on the adapter kit&lt;br&gt;&lt;br&gt;Opens the connection;&lt;br&gt;never writes PostgreSQL&lt;br&gt;&lt;br&gt;&lt;i&gt;IN-PROCESS SIMULATORS:&lt;br&gt;TESTS ONLY&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1080" y="250" width="260" height="560" as="geometry"/></mxCell>
        <mxCell id="runtime" value="&lt;b&gt;Qualified agent runtime&lt;/b&gt;&lt;br&gt;Reasoning and native session/turn lifecycle&lt;br&gt;&lt;i&gt;PROVIDER OPEN&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="250" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="environment" value="&lt;b&gt;Qualified environment provider&lt;/b&gt;&lt;br&gt;Workspace, process, isolation and cleanup&lt;br&gt;&lt;i&gt;PROVIDER OPEN&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="400" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="enforcement" value="&lt;b&gt;Action enforcement path&lt;/b&gt;&lt;br&gt;Runtime hook or policy / tool / secret gateway&lt;br&gt;&lt;i&gt;REQUIRED FOR GOVERNED ACTIONS&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="550" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="artifact-store" value="&lt;b&gt;Artifact byte storage&lt;/b&gt;&lt;br&gt;Immutable evidence bytes&lt;br&gt;&lt;i&gt;PROVIDER OPEN&lt;/i&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#333333;fontColor=#111111;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1500" y="700" width="260" height="110" as="geometry"/></mxCell>
